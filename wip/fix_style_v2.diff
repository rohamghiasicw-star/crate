+# THE STYLE WAVE (find_edit, after every other wave): runs ONLY when nothing scored is the
+# clip's own file - no row that is the same recording (core >= CORE_SAME or fp >= FP_CONF)
+# AT THE CLIP'S TEMPO (_style_same_row: inside the server's crown band). With chromaprint
+# working (fpcalc was broken until 2026-09-26 20:55, so every fp read 0 before that) a pool
+# with no such row provably never downloaded the upload in the clip, and every other
+# answer is a guess about a family.
+#
+# Measured 2026-09-26 on Konnor's ZSbYhvyNJ ("son original - GN7.production", Shazam
+# "Don't Like"): the exact upload, soundcloud.com/4990desy/chief-keef-i-dont-like-remix
+# ("Chief Keef - I Don't Like (remix)", 44.8s, 74K plays), verifies at fp 0.966, arr
+# 0.698, vspeed 1.000, bass -0.62 and every band 20 Hz-8 kHz within 0.3 dB of the clip.
+# It WAS in the main pool (row 66 of 338, from the hint query "i dont like chief keef")
+# and it WAS one of the 17 section rows the length lane saw, but that lane keeps the 2
+# rows nearest the clip's own length (23.6s, 24.6s, both core < 0.3) and the 44.8s file
+# never got a download. The crown went to a 0.558 "TikTok version" instead.
+#
+# So the wave spends, under a hard cap:
+#   * THE SECTION ROWS THE LENGTH LANE CUT, most-played first (the complementary order:
+#     the upload people actually use). Same row rule as evidence_rows plus
+#     _style_title_ok, so "never goodbye - i don't like me either" does not pass for
+#     "Don't Like".
+#   * AT MOST STYLE_WAVE_Q QUERIES, each a style the clip's MEASURED audio supports
+#     (_style_wave_words): a measured speed (known_dir, else the sweep's ratio) and a bass
+#     excess over the consensus of every scored row with audio merit, gated on BOTH tilt
+#     (>= STYLE_BASS_X dB, the verifier's own TILT_FREE_DB noise floor) and the
+#     pitch-invariant slope (>= STYLE_SLOPE_X, server.SLOPE_BOOST_GAP), because a slow
+#     alone forges tilt. Plus the credited sound author and a remixer credit with the
+#     song. Every query the hunt already asked (same word set) is dropped, so on most
+#     clips the wave is the section lane alone.
+# These are SEARCH words, never labels: the bass / speed labels the user sees are computed
+# where they always were. APPENDED rows only; verify() still has the only vote.
+STYLE_WAVE_Q, STYLE_WAVE_DL, STYLE_WAVE_SEC = 4, 6, 3
+STYLE_WAVE_CAP = 9.0          # seconds, search + downloads, hard (abandoned rows are dropped)
+STYLE_WAVE_SEARCH_S = 5.0     # the search leg's own ceiling inside the cap
+STYLE_BASS_X = 2.0            # dB, median clip-minus-candidate tilt over merit rows
+STYLE_SLOPE_X = 0.40          # dB/decade, the same rows' median slope_delta
+STYLE_BASS_MIN_ROWS = 3
+
+
+def _style_same_row(rows):
+    """The first scored row that already IS the clip's file, or None. Pure.
+    Same recording (core >= CORE_SAME, or raw fp >= FP_CONF) AND at the clip's own tempo:
+    |log2(vspeed)| <= FAST_EXIT_TEMPO, the band server.py's _crown_tempo_mismatch keeps a
+    crown in (the same number the fast exit uses, for the same reason). A same-recording
+    row at another speed is by definition a different edit, and core saturates on those.
+    Measured 2026-09-27 on the ship engine, Konnor's ZSbYhvyNJ: creator_align slid "Chief
+    Keef - I Don't Like [Remix] (Slowed to Perfection)" to core 1.000 / fp 0.672 at vspeed
+    1.059 (|log2| 0.083, which the server refuses as a crown). The old core-or-fp test read
+    that as "same master" and skipped the wave, so desy's upload (fp 0.958, vspeed 1.000)
+    was never downloaded. Regression crowns all sit inside the band: kelthraxx, mason and
+    bouch at 1.000, kyks at 1.0193 (|log2| 0.028)."""
+    for c in rows or []:
+        if not c.get("_done"):
+            continue
+        if (c.get("core") or 0) < CORE_SAME and (c.get("fp") or 0) < _verify.FP_CONF:
+            continue
+        v = max(0.25, min(4.0, float(c.get("vspeed") or 1.0)))
+        if abs(float(np.log2(v))) <= FAST_EXIT_TEMPO:
+            return c
+    return None
+
+
+def _style_wave_words(cands, known_dir, edit_label):
+    """(words, why): the style words the clip's MEASURED audio supports. Pure.
+    Speed from known_dir, else the sweep ratio in edit_label ("slowed ~0.89x"). Bass from
+    the median bass_delta AND median slope_delta over scored rows that carry the song and
+    cleared CORE_MERIT, at least STYLE_BASS_MIN_ROWS of them."""
+    words, why = [], []
+    kd = known_dir or ""
+    if not kd:
+        m = _LABEL_RATIO.search(edit_label or "")
+        if m:
+            r = float(m.group(1))
+            kd = "slowed" if r < 0.97 else ("sped up" if r > 1.03 else "")
+    if "slow" in kd:
+        words.append("slowed"); why.append("speed:slowed")
+    elif "sped" in kd:
+        words.append("sped up"); why.append("speed:sped")
+    rows = [c for c in cands or [] if c.get("_done") and (c.get("core") or 0) >= CORE_MERIT
+            and (c.get("song_cov") or 0) >= 1.0]
+    if len(rows) >= STYLE_BASS_MIN_ROWS:
+        bx = float(np.median([float(c.get("bass_delta") or 0.0) for c in rows]))
+        sx = float(np.median([float(c.get("slope_delta") or 0.0) for c in rows]))
+        if bx >= STYLE_BASS_X and sx >= STYLE_SLOPE_X:
+            words.append("bass boosted")
+        why.append("bass:%+.1fdB/%+.2f/%d" % (bx, sx, len(rows)))
+    else:
+        why.append("bass:rows<%d" % STYLE_BASS_MIN_ROWS)
+    return words, why
+

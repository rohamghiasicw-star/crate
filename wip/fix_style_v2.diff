+def _hint_song_name(hints, song_terms, max_words=6):
+    """The first comment hint that names the song in a short form ("I don't like - Chief
+    keef (Ft Lil reese)" -> "I don t like Chief keef"): brackets stripped, every song word
+    present, at most max_words words. The crowd's name for the song is often not Shazam's
+    ("I Don't Like" vs "Don't Like"), and platform search is literal. Pure."""
+    for h in hints or []:
+        s = _clean(re.sub(r"[\(\[].*?[\)\]]", " ", h or ""))
+        low = s.lower()
+        if (s and len(s.split()) <= max_words and song_terms
+                and all(t in low for t in song_terms)):
+            return s
+    return None
+
+
+def _style_wave_queries(core_title, base_artist, hint_name, credit_author, words,
+                        credit_ev, asked, cap=STYLE_WAVE_Q):
+    """At most `cap` queries, none whose word set the hunt already searched. Pure."""
+    seen = {frozenset(_clean(q).lower().split()) for q in asked or [] if q}
+    out = []
+
+    def add(s):
+        s = _clean(s)
+        k = frozenset(s.lower().split())
+        if s and len(k) >= 2 and k not in seen and len(out) < cap:
+            seen.add(k); out.append(s)
+    core = _clean(core_title)
+    art = _first_artist(base_artist)
+    w = " ".join(words)
+    if w:
+        add("%s %s %s" % (art, core, w))
+        if hint_name:
+            add("%s %s" % (hint_name, w))
+        add("%s %s" % (core, w))
+    ca = _clean(credit_author or "")
+    if ca and ca.lower() not in (base_artist or "").lower() and ca.lower() not in ORIGINAL_WORDS:
+        add("%s %s" % (ca, core))
+    if credit_ev and art:
+        add("%s %s" % (core, art))
+    return out
+
+
+def _style_wave_ok(c, core_title):
+    """Is this row a fair style-wave download: not scored yet, an edit OF this song, not a
+    rendition / type beat / compilation / SoundCloud 30s preview. Pure."""
+    t = _ascii_fold(c.get("title") or "")
+    return (not c.get("_done") and (c.get("song_cov") or 0) >= 1.0
+            and _style_title_ok(c.get("title"), core_title)
+            and not OTHER_RENDITION.search(t) and not _TYPE_BEAT.search(t)
+            and not _is_compilation(c)
+            and not (c.get("source") == "soundcloud" and abs(_dur_s(c) - 30.0) < 0.01))
+
+
+def _style_wave_pick(pool, lanes, core_title, clip_len, want=STYLE_WAVE_DL,
+                     sec_want=STYLE_WAVE_SEC):
+    """Round-robin the download list. Lane 0 is the SECTION rows already in the pool
+    (0.5x-3x the clip, at least 90s allowed, a treatment or section word in the title),
+    most-played first, at most sec_want. Then one lane per style query, in the platform's
+    order, a section-length row first, then a row whose title carries the query's style
+    words, then YouTube first, then plays. Pure."""
+    L = float(clip_len or 0)
+    short_max = max(90.0, 3.0 * L)
+
+    def is_sec(c):
+        d = _dur_s(c)
+        return L > 0 and 0.5 * L <= d <= short_max
+    sec = []
+    for c in pool or []:
+        t = _ascii_fold(c.get("title") or "").lower()
+        if (_style_wave_ok(c, core_title) and is_sec(c)
+                and (EDIT_WORDS.search(t) or _SECTION_WORD.search(t))):
+            sec.append(c)
+    sec.sort(key=lambda c: -(c.get("plays") or 0))
+    ordered = [sec[:sec_want]]
+    for q, rows in lanes:
+        terms = [x for x in _clean(q).lower().split() if x in ("slowed", "sped", "bass", "boosted")]
+        lane = []
+        for rank, c in enumerate(rows):
+            if not _style_wave_ok(c, core_title):
+                continue
+            t = _ascii_fold(c.get("title") or "").lower()
+            lane.append((0 if is_sec(c) else 1, -sum(1 for x in terms if x in t),
+                         0 if c.get("source") == "youtube" else 1, -(c.get("plays") or 0),
+                         rank, c))
+        lane.sort(key=lambda x: x[:5])
+        ordered.append([x[-1] for x in lane])
+    out, ids = [], set()
+    while any(ordered) and len(out) < want:
+        for lane in ordered:
+            while lane:
+                c = lane.pop(0)
+                if id(c) not in ids and c.get("url") not in {x.get("url") for x in out}:
+                    ids.add(id(c)); out.append(c)
+                    break
+            if len(out) >= want:
+                break
+    return out
 

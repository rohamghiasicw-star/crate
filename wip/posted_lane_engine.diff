+def _uni_words(t, strip_brackets=False):
+    """Title words in ANY script. _title_key keeps only a-z0-9 for Latin-bearing titles, so
+    "ФРУКТОВЫЙ 1.0" keys as "1 0"; this keeps the Cyrillic word. NFKC also maps the
+    mathematical-alphanumeric fonts uploaders use back to plain letters."""
+    t = t or ""

+        t = re.sub(r"[\(\[].*?[\)\]]", " ", t)
+    return re.sub(r"[^\w]|_", " ", unicodedata.normalize("NFKC", t).lower()).split()
 
 
+def _posted_words(title):
+    """The distinctive words of a song title (3+ letters, not a number)."""
+    return {w for w in _uni_words(title, strip_brackets=True)
+            if len(w) >= 3 and not w.isdigit() and w not in ("the", "and", "feat")}
+

 _RENDITION_WORDS = re.compile(r"\b(remix|version|mashup|flip|edit)\b", re.I)
 
 
+def _reversed_null_located(clip_audio, cand_url, tmp, _verify):
+    """_time_reversed_null for a POSTED-LANE crown (crate_engine POSTED_LANE; the caller
+    passes locate=True only for a row the engine marked `posted_proven`). Two differences,
+    both measured on DcQG-yFuQ6g (a rap over a trap beat, 2026-09-27):
+    1. The control runs WHERE THE CLIP SITS in the upload (hard-rules: candidates are scored on
+       their first 20s only; locate the clip, never a blind re-decode). 25s windows every 5s
+       over the first 120s, the best raw fp wins.
+    2. Collapse is judged on raw fp as well as core. This clip's chroma is dominated by the
+       beat's held notes, which read the same backwards, so the reversed copy of the right
+       upload still fingerprints 0.73, above verify.FP_HI, and core pins at 1.000 both ways.
+       Raw fp is not saturated (findings/mason-exact-mix.md): located, "ФРУКТОВЫЙ 1.0" reads
+       0.945 forward and 0.728 reversed. Refused when reversed core >= forward core AND the
+       raw fp drops by less than FP_LEAD, i.e. when neither signal says direction matters.
+    -> a refusal, "" when the control passed, or None when it could not be measured (the
+    caller then runs the plain control). The file must be a .wav: dl_clip handed a .m4a
+    destination at 120s writes cand_long.wav and returns None (measured 2026-09-27)."""
+    import subprocess
+    dst = os.path.join(tmp, "cand_long.wav")
+    got = E.dl_clip(cand_url, dst, seconds=120, timeout=30)
+    if not got:
+        return None
+    src = got if isinstance(got, str) else dst
+    dur = E.duration_of(src) or 0
+    ctx = _verify.prepare_clip(clip_audio)
+    seg = os.path.join(tmp, "seg.wav")
+    best = None
+    for off in range(0, max(1, int(dur) - 20), 5):
+        subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-ss", str(off), "-i", src,
+                        "-t", "25", "-ac", "1", "-ar", "44100", seg], check=True, timeout=30)
+        v = _verify.verify(clip_audio, seg, 20, clip_ctx=ctx)
+        if best is None or (v.get("fp") or 0) > (best[1].get("fp") or 0):
+            best = (off, v)
+    if best is None:
+        return None
+    off, fv = best
+    rev = os.path.join(tmp, "rev.wav")
+    subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-ss", str(off), "-i", src, "-t", "25",
+                    "-af", "areverse", "-ac", "1", "-ar", "44100", rev], check=True, timeout=30)
+    rv = _verify.verify(clip_audio, rev, 20, clip_ctx=ctx)
+    fc, ff = (fv.get("core") or 0.0), (fv.get("fp") or 0.0)
+    rc, rf = (rv.get("core") or 0.0), (rv.get("fp") or 0.0)
+    E.tlog("reversed_null_located", 0.0, at=off, fwd_core=round(fc, 3), fwd_fp=round(ff, 3),
+           rev_core=round(rc, 3), rev_fp=round(rf, 3))
+    if rc >= fc and (ff - rf) < E.FP_LEAD:
+        return ("scores %.3f against a time-reversed copy of itself, so the match is "
+                "texture, not this recording" % rc)
+    return ""

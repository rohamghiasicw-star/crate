+# THE CROWN IS THE SONG SHAZAM HEARD AS POSTED (crate_engine POSTED_LANE). DcQG-yFuQ6g
+# (Konnor 2026-09-27, "why didn't it find the rap part"): the sweep named the beat, "Sanya
+# (Sped Up)", by re-pitching the clip and overruled "ФРУКТОВЫЙ 1.0" at 1.0x in every window.
+# When the version hunt crowns an upload of the posted song and that upload is proven
+# (engine `posted_proven`: raw fp >= verify.FP_CONF and a lead >= FP_LEAD over every scored
+# row that does not name it), the header must name what the crown is, or it contradicts the
+# crown. The old base becomes the beat line (`beat`), with the notes that were about it.
+# Only when the two titles share no word (mason's "Teach Me How to Dougie" over "Dougie
+# Freestyle" is one family, not a rap over a beat) and the crown does not name the rival.
+# Inert without fp["posted"], so every other clip is byte-identical.
+def _name_posted(res, fp, top):
+    """End of phase 2, after res["exact"] is final. -> True when the posted reading now names
+    the result."""
+    po = (fp or {}).get("posted")
+    ex = res.get("exact")
+    if not (isinstance(po, dict) and po.get("title") and isinstance(top, dict)
+            and top.get("posted_proven") and isinstance(ex, dict)
+            and ex.get("url") == top.get("url") and res.get("base_song")
+            and not res.get("base_uncertain") and not res.get("rendition")):
+        return False
+    pw = E._posted_words(po.get("title"))
+    rw = E._posted_words(po.get("rival") or res.get("base_song"))
+    if not pw or (pw & rw):
+        return False
+    crown_w = set(E._uni_words("%s %s" % (top.get("title") or "", top.get("uploader") or "")))
+    if (rw & crown_w) or not (pw <= crown_w):
+        return False
+    beat = {"title": res.get("base_song"), "artist": res.get("base_artist"),
+            "shazam": res.get("shazam"), "speed": res.get("speed")}
+    for k in ("reupload", "speed_disputed", "speed_measured", "speed_refs", "speed_source"):
+        if k in res:
+            beat[k] = res.pop(k)
+    res["beat"] = beat
+    sk = po.get("freqskew")
+    # Shazam's own pitch reading of the posted windows, the 4% deadband _name_rendition uses
+    sp = ("as posted" if sk is None or abs(sk) < 0.04 else
+          "%s ~%.2fx" % ("slowed" if sk < 0 else "sped up", 1.0 + sk))
+    # ...but it is read against Shazam's catalogue copy, and the crown is a different upload.
+    # When the crown's own measured tempo points the OTHER way, the header would contradict
+    # the crown line, so no speed is claimed (what DcQG showed before: speed None). Measured
+    # on DcQG: Shazam +0.048 ("sped up ~1.05x") while the crowned upload reads vspeed 0.9636
+    # ("this upload runs about 4% faster than the clip"). verify's bare 1.0 is "unmeasured".
+    _v = top.get("vspeed_locked")
+    if _v is None:
+        _v = top.get("vspeed")
+    _dc = 0
+    if _v and float(_v) > 0 and float(_v) != 1.0 and abs(math.log2(float(_v))) > _TEMPO_EXACT:
+        _dc = 1 if float(_v) > 1.0 else -1
+    _ds = 0 if (sk is None or abs(sk) < 0.04) else (1 if sk > 0 else -1)
+    if _ds and _dc and _ds != _dc:
+        sp = None
+    if sp and res.get("bass_boosted"):
+        sp = "bass boosted" if sp == "as posted" else sp + " + bass boosted"
+    res["posted"] = {"title": po["title"], "artist": po.get("artist"),
+                     "windows": po.get("windows"), "fp": round(float(top.get("fp") or 0), 3),
+                     "lead": top.get("posted_lead")}
+    res["base_song"], res["base_artist"] = po["title"], po.get("artist")
     res["speed"] = sp
+    for k, v in (("shazam", po.get("url")), ("art", po.get("art"))):
+        if v:
+            res[k] = v
+        else:
+            res.pop(k, None)
+    res.pop("preview_url", None)
+    try:                                 # the links follow the name on screen
+        _lk = L.official_links(po["title"], po.get("artist"))
+        if _lk.get("links"):
+            res["links"] = _lk["links"]
+        if _lk.get("preview"):
+            res["preview_url"] = _lk["preview"]
+        if _lk.get("art") and not res.get("art"):
+            res["art"] = _lk["art"]
+    except Exception:
+        pass
+    E.tlog("posted_named", 0.0, title=(po.get("title") or "")[:80],
+           beat=(beat.get("title") or "")[:80], crown=(top.get("title") or "")[:80],
+           fp=res["posted"]["fp"], lead=res["posted"]["lead"], skew=sk, crown_v=_v, speed=sp)
     return True
 
 

# Addify engine environment (systemd EnvironmentFile for addify-engine.service).
# install.sh copies this to /etc/addify/engine.env on every run. To change a value, put the
# line in /etc/addify/engine.local.env (read second, so it wins), then:
#   systemctl restart addify-engine      (running scans finish first, up to ADDIFY_DRAIN_S)
#
# --- the same switches the Mac's restart_live.sh sets, where they make sense on Linux ---
PORT=8788
# Mac: BIND=0.0.0.0 (LAN phones). Here only the local tunnel connects, so loopback only.
BIND=127.0.0.1
# Mac: CRATE_TIMING=/tmp/tlog.jsonl. Here a rotated log; check.sh reads throttles from it.
CRATE_TIMING=/var/log/addify/tlog.jsonl
# Mac: IG_LOCAL_SESSION=1 (the owner's Instagram login). NEVER on a server (Meta terms);
# public Instagram reels still work without it, carousels do not.
#
# --- Linux basics ---
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
HOME=/home/addify
PATH=/opt/addify/venv/bin:/usr/local/bin:/usr/bin:/bin
TMPDIR=/var/tmp/addify
XDG_CACHE_HOME=/var/lib/addify/xdg-cache
DENO_DIR=/var/lib/addify/deno
CRATE_PERSIST_DIR=/var/lib/addify/cache
CRATE_DATA_DIR=/var/lib/addify/data
# No ShazamKit on Linux. The repo's shazam_backend.txt says shazamkit (the Mac); this wins.
CRATE_SHAZAM_BACKEND=shazamio
# No Homebrew: YouTube search/download use the venv's yt-dlp (and its long-lived worker).
CRATE_YTDLP_BIN=/opt/addify/venv/bin/yt-dlp
#
# --- server.diff switches (all OFF on the Mac) ---
# Shazam pacing: at most N calls in any rolling window. Measured: Shazam takes 22 a minute
# from one IP, then 429 until the minute is up; one 429 still came at 20 per 60.5 s under load,
# so 18 per 61 s (README). A probe waits for a slot instead of failing, capped per probe and
# per scan; what cannot get through makes the scan "busy".
CRATE_SHAZAM_PACE=1
CRATE_SHAZAM_PACE_N=18
CRATE_SHAZAM_PACE_WINDOW_S=61
CRATE_SHAZAM_PACE_MAX_WAIT_S=58
CRATE_SHAZAM_PACE_SCAN_WAIT_S=62
CRATE_SHAZAM_429_BACKOFF_S=4
# Kill yt-dlp's whole process group on a timeout (no orphaned ffmpeg).
CRATE_KILL_PGROUP=1
# Scan gate: heavy halves at once (/base and /edits/stream both count), queue, busy answer.
# auto = one per 2.5 vCPU (the 8 vCPU droplet: 3). A number overrides it.
ADDIFY_SCAN_SLOTS=auto
ADDIFY_SCAN_QUEUE_MAX=8
ADDIFY_SCAN_QUEUE_WAIT_S=20
ADDIFY_EDITS_WAIT_S=120
ADDIFY_EDITS_RESERVE_S=45
ADDIFY_BUSY_RETRY_S=20
# Clean stop: running scans get up to this long (systemd TimeoutStopSec is 130).
ADDIFY_DRAIN_S=110
ADDIFY_TMP_SWEEP=1

# addify-tunnel.service environment. install.sh copies this to /etc/addify/tunnel.env on every
# run; overrides go in /etc/addify/tunnel.local.env.
ENGINE_URL=http://127.0.0.1:8788
# The public gist the iOS app reads (EngineConfig.swift). Same id as the Mac's ~/crate/.engine_gist_id.
GIST_ID=d63fcb85b88d9a8f12e943605dd0a078
GIST_FILE=engine-url.txt
STATE_DIR=/var/lib/addify/tunnel
# Publishing to the gist happens ONLY while this file exists. install.sh never creates it;
# cutover.sh does, rollback.sh deletes it.
PUBLISH_FLAG=/var/lib/addify/tunnel/gist-publish.on

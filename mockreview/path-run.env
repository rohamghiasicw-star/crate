# Settings for .github/workflows/review-sim-path.yml. A push that changes this file starts a run.
# MR_SCANS=1 lets the scan walks fire real scans on the TEST box (budgeted per device job, at
# most 12 for the whole lane, one at a time). Never the live server: it is blocked on the runner.
MR_SCANS=0
# Space-separated walk groups: launch fresh tryreel taps largetext rotate store delete scans runtime272 store26
MR_GROUPS=store26
